        "\n",
        "# If the paths printed above are different from the ones in the Dataloader cell below, \n",
        "# you will need to copy the correct paths and paste them into the Dataloader cell!"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "execution_count": null,
      "outputs": [],
      "source": [
        "!pip install transformers scikit-learn pillow h5py -q\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from PIL import Image\n",
        "import io\n",
        "import h5py\n",
        "from torchvision import transforms\n",
        "from transformers import ViTModel, ViTConfig\n",
        "from sklearn.metrics import roc_auc_score\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "execution_count": null,
      "outputs": [],
      "source": [
        "# 1. Re-define the DermAI Architecture\n",
        "class MetadataCrossAttention(nn.Module):\n",
        "    def __init__(self, embed_dim, metadata_dim):\n",
        "        super().__init__()\n",
        "        self.metadata_proj = nn.Linear(metadata_dim, embed_dim)\n",
        "        self.query_proj = nn.Linear(embed_dim, embed_dim)\n",
        "        self.key_proj = nn.Linear(embed_dim, embed_dim)\n",
        "        self.value_proj = nn.Linear(embed_dim, embed_dim)\n",
        "        self.attn = nn.MultiheadAttention(embed_dim, num_heads=8, batch_first=True)\n",
        "        self.norm = nn.LayerNorm(embed_dim)\n",
        "\n",
        "    def forward(self, x, metadata):\n",
        "        m_proj = self.metadata_proj(metadata).unsqueeze(1)\n",
        "        q = self.query_proj(m_proj)\n",
        "        k = self.key_proj(x)\n",
        "        v = self.value_proj(x)\n",
        "        attn_out, _ = self.attn(q, k, v)\n",
        "        return self.norm(m_proj + attn_out).squeeze(1)\n",
        "\n",
        "class DermAIEngine(nn.Module):\n",
        "    def __init__(self, metadata_dim=4):\n",
        "        super().__init__()\n",
        "        self.config = ViTConfig.from_pretrained('google/vit-base-patch16-224-in21k')\n",
        "        self.vit = ViTModel.from_pretrained('google/vit-base-patch16-224-in21k')\n",
        "        self.cross_attn = MetadataCrossAttention(self.config.hidden_size, metadata_dim)\n",
        "        self.risk_head = nn.Linear(self.config.hidden_size, 1)\n",
        "        self.mutation_head = nn.Linear(self.config.hidden_size, 1)\n",
        "\n",
        "    def forward(self, pixel_values, metadata):\n",
        "        patch_embeddings = self.vit(pixel_values=pixel_values).last_hidden_state\n",
        "        fused = self.cross_attn(patch_embeddings, metadata)\n",
        "        return torch.sigmoid(self.risk_head(fused)), torch.sigmoid(self.mutation_head(fused))\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "execution_count": null,
      "outputs": [],
      "source": [
        "# 2. Build the ISIC 2024 HDF5 Dataloader\n",
        "# Kaggle mounts 2024 images in massive HDF5 chunks, allowing extremely fast reads without unzipping!\n",
        "\n",
        "class ISIC2024HDF5Dataset(Dataset):\n",
        "    def __init__(self, csv_file, hdf5_file, transform=None):\n",
        "        print(\"Loading metadata CSV...\")\n",
        "        self.df = pd.read_csv(csv_file)\n",
        "        self.hdf5_file = hdf5_file\n",
        "        self.transform = transform\n",
        "        \n",
        "        # Clean metadata\n",
        "        self.df['age_approx'] = self.df['age_approx'].fillna(45.0)\n",
        "        self.df['sex'] = self.df['sex'].fillna('unknown')\n",
        "        self.df['anatom_site_general'] = self.df['anatom_site_general'].fillna('unknown')\n",
        "        \n",
        "        # Open HDF5 lazily\n",
        "        self.file = h5py.File(self.hdf5_file, 'r')\n",
        "\n",
        "    def __len__(self): \n",
        "        return len(self.df)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        row = self.df.iloc[idx]\n",
        "        isic_id = row['isic_id']\n",
        "        \n",
        "        # Read compressed image bytes from HDF5 directly into memory (zero disk usage!)\n",
        "        img_bytes = self.file[isic_id][()]\n",
        "        image = Image.open(io.BytesIO(img_bytes)).convert('RGB')\n",
        "        if self.transform: image = self.transform(image)\n",
        "        \n",
        "        # Encode Metadata\n",
        "        age_norm = float(row['age_approx']) / 100.0\n",
        "        sex_enc = 1.0 if row['sex'] == 'male' else 0.0\n",
        "        \n",
        "        loc_map = {'head/neck': 0.0, 'torso': 0.25, 'upper extremity': 0.5, 'lower extremity': 0.75, 'palms/soles': 1.0}\n",
        "        loc_enc = 0.5\n",
        "        for k, v in loc_map.items():\n",
        "            if k in row['anatom_site_general']:\n",
        "                loc_enc = v\n",
        "                break\n",
        "                \n",
        "        md = torch.tensor([age_norm, sex_enc, loc_enc, 0.0], dtype=torch.float32)\n",
        "        risk = torch.tensor([row['target']], dtype=torch.float32)\n",
        "        mut = torch.tensor([0.0], dtype=torch.float32)\n",
        "        \n",
        "        return image, md, risk, mut\n",
        "\n",
        "transform = transforms.Compose([\n",
        "    transforms.Resize((224, 224)),\n",
        "    transforms.RandomHorizontalFlip(),\n",
        "    transforms.RandomRotation(15),\n",
        "    transforms.ToTensor(),\n",
        "    transforms.Normalize([0.5]*3, [0.5]*3)\n",
        "])\n",
        "\n",
        "print(\"Initializing dataset from Kaggle mounted drives...\")\n",
        "# These paths exist natively in Kaggle Notebooks attached to the competition!\n",
        "train_csv_path = '/kaggle/input/isic-2024-challenge/train-metadata.csv'\n",
        "train_hdf5_path = '/kaggle/input/isic-2024-challenge/train-image.hdf5'\n",
        "\n",
        "try:\n",
        "    dataset = ISIC2024HDF5Dataset(train_csv_path, train_hdf5_path, transform)\n",
        "    train_size = int(0.9 * len(dataset))\n",
        "    val_size = len(dataset) - train_size\n",
        "    train_dataset, val_dataset = torch.utils.data.random_split(dataset, [train_size, val_size])\n",
        "    \n",
        "    # Kaggle's Dual-T4 allows large batches\n",
        "    train_loader = DataLoader(train_dataset, batch_size=128, shuffle=True, num_workers=4, pin_memory=True)\n",
        "    val_loader = DataLoader(val_dataset, batch_size=128, num_workers=4, pin_memory=True)\n",
        "    print(f\"Successfully loaded {len(dataset)} images from HDF5 memory stream!\")\n",
        "except Exception as e:\n",
        "    print(\"Error loading dataset. Are you running this in Kaggle and attached the ISIC 2024 data?\", e)\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "execution_count": null,
      "outputs": [],
      "source": [
        "# 3. High-Performance Dual-GPU Training Loop\n",
        "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "model = DermAIEngine(metadata_dim=4)\n",
        "\n",
        "if torch.cuda.device_count() > 1:\n",
        "    print(f\"Let's use {torch.cuda.device_count()} GPUs!\")\n",
        "    model = nn.DataParallel(model)\n",
        "\n",
        "model = model.to(device)\n",
        "\n",
        "# Freeze ViT backbone initially\n",
        "for param in model.module.vit.parameters() if hasattr(model, 'module') else model.vit.parameters(): \n",
        "    param.requires_grad = False\n",
        "\n",
        "optimizer = optim.AdamW(filter(lambda p: p.requires_grad, model.parameters()), lr=1e-4, weight_decay=1e-2)\n",
        "criterion = nn.BCELoss()\n",
        "\n",
        "epochs = 3 # Can take ~8-10 hours depending on dataset size\n",
        "best_val_auc = 0.0\n",
        "\n",
        "print(\"Starting Phase 1: Heavy Transfer Learning...\")\n",
        "for epoch in range(epochs):\n",
        "    model.train()\n",
        "    for i, (imgs, mds, risks, _) in enumerate(train_loader):\n",
        "        optimizer.zero_grad()\n",
        "        risk_pred, _ = model(imgs.to(device), mds.to(device))\n",
        "        loss = criterion(risk_pred, risks.to(device))\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "        \n",
        "        if i % 100 == 0: \n",
        "            print(f\"Epoch {epoch+1}/{epochs} | Batch {i}/{len(train_loader)} | Loss: {loss.item():.4f}\")\n",
        "\n",
        "    # Validation\n",
        "    model.eval()\n",
        "    preds, labels = [], []\n",
        "    with torch.no_grad():\n",
        "        for imgs, mds, risks, _ in val_loader:\n",
        "            risk_pred, _ = model(imgs.to(device), mds.to(device))\n",
        "            preds.extend(risk_pred.cpu().numpy())\n",
        "            labels.extend(risks.cpu().numpy())\n",
        "            \n",
        "    val_auc = roc_auc_score(labels, preds)\n",
        "    print(f\"\\n>>> Epoch {epoch+1} Completed | Validation ROC-AUC: {val_auc:.4f} <<<\\n\")\n",
        "    \n",
        "    if val_auc > best_val_auc:\n",
        "        best_val_auc = val_auc\n",
        "        state_dict = model.module.state_dict() if hasattr(model, 'module') else model.state_dict()\n",
        "        torch.save(state_dict, '/kaggle/working/engine_isic_best.pth')\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "execution_count": null,
      "outputs": [],
      "source": [
        "# 4. Final Output\n",
        "print(f\"Training complete! Best Validation AUC: {best_val_auc:.4f}\")\n",
        "print(\"The highly accurate weights have been saved to /kaggle/working/engine_isic_best.pth\")\n",
        "print(\"You can download them from the Output pane on the right side of your Kaggle screen!\")\n"
      ]
    }
